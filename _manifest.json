{
  "manifest_version": 2,
  "id": "neko.tts",
  "version": "0.6.1",
  "name": "Neko TTS",
  "description": "固定提示 MiMo 语音；支持 Planner 主动选择和随机＋主动混合模式。",
  "author": { "name": "NekoLaska", "url": "https://github.com/znzsofficial" },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/znzsofficial/neko-tts",
    "documentation": "https://github.com/znzsofficial/neko-tts/blob/main/README.md",
    "issues": "https://github.com/znzsofficial/neko-tts/issues"
  },
  "host_application": { "min_version": "1.3.5", "max_version": "1.99.99" },
  "sdk": { "min_version": "2.10.0", "max_version": "2.99.99" },
  "dependencies": [ { "type": "python_package", "name": "aiohttp", "version_spec": ">=3.12" } ],
  "capabilities": ["send.custom"],
  "i18n": { "default_locale": "zh-CN", "supported_locales": ["zh-CN"] }
}
